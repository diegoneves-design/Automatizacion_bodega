# Plantilla de variables de entorno. Copiar a .env y completar los valores.
# Las claves reales NUNCA se suben al repositorio (.env esta en .gitignore).

# Ruta del archivo SQLite (si queda vacia se usa bodega.db)
BODEGA_DB_PATH=

# Integracion futura con el ERP (fuera del alcance del MVP)
ERP_API_URL=
ERP_API_KEY=

# Prototipo conectado a Supabase (prueba de concepto). Ver README.
# Direccion del proyecto, por ejemplo https://abcdefgh.supabase.co
SUPABASE_URL=
# Clave PUBLICABLE (empieza con sb_publishable_). Nunca la clave secreta ni service_role.
SUPABASE_PUBLISHABLE_KEY=

# MVP (aplicacion Streamlit) conectado a Supabase.
# Si DATABASE_URL esta vacia, el MVP usa una base SQLite local de pruebas (bodega_mvp.db, o BODEGA_MVP_DB).
# Cadena de conexion del POOLER en modo SESION (puerto 5432), con el rol limitado app_mvp, NO con postgres.
# Forma: postgresql://app_mvp.<referencia-del-proyecto>:<contrasena>@<servidor-del-pooler>:5432/postgres
# De donde copiarla y como armarla: docs/mvp-supabase.md. Va solo aqui (.env) o en los secretos del hosting.
DATABASE_URL=

# Solo para las pruebas opcionales contra PostgreSQL (tests/test_contrato_repo.py). Debe ser una base VACIA DE PRUEBA
# cuyo nombre termina en _test: la prueba borra y recrea el esquema public. NUNCA la base de verdad.
DATABASE_URL_TEST=

# Vista Dashboard del MVP (analisis del inventario real). Solo aparece si vale 1. Dejala vacia (apagada) en un hosting publico
# hasta confirmar con la bodega que el inventario real se puede mostrar (pregunta 4 de docs/analisis-inventario.md).
DASHBOARD_INVENTARIO=
